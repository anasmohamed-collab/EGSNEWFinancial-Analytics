# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build

# VCS & tooling
.git
.gitignore
.github

# Secrets & local env (NEVER copy into the image)
.env
.env.*
!.env.example

# Local uploaded files (must not be baked into the image)
storage/uploads/*
!storage/uploads/.gitkeep

# Local Postgres / compose (not needed in the app image)
docker-compose.yml

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Tests & docs (not needed at runtime)
**/*.test.ts
coverage
