# ---------------------------------------------------------------------------
# Eagles Budget CRM - Environment Variables
# Copy this file to `.env` for local dev, or set the values in your platform.
# NEVER commit a real `.env` — it is gitignored.
#
# Variables are grouped by when they are actually needed. Only the UNCOMMENTED
# keys below are needed to deploy + run now; commented keys are optional,
# local-only, or reserved for a future step.
# ===========================================================================


# ============================================================
# 1) REQUIRED FOR PRODUCTION  (set these in Dublyo)
# ============================================================

# PostgreSQL connection string. Prisma reads this (datasource).
# LOCAL dev value shown below (matches docker-compose.yml).
# PRODUCTION: replace with your managed Postgres URL and require SSL, e.g.:
#   postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require
DATABASE_URL="postgresql://eagles:eagles_secret@localhost:5432/eagles_budget?schema=public"

# Secret used to sign auth session JWTs. MUST be a long random string (>=32) in prod.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"


# ============================================================
# 2) ONE-TIME ADMIN SEED  (needed only when running `npm run db:seed`)
#    Provide them for the first seed, then they are not required at runtime.
# ============================================================
SEED_ADMIN_EMAIL="admin@eaglesgroup.local"
SEED_ADMIN_PASSWORD="Admin@12345"


# ============================================================
# 3) OPTIONAL  (safe defaults — uncomment ONLY to override)
# ============================================================
# NODE_ENV is set to "production" automatically by `next start`. Override only if needed.
# NODE_ENV="production"
#
# UPLOAD_DIR defaults to ./storage/uploads, which resolves to /app/storage/uploads
# in the container (the declared VOLUME). Override only if your persistent volume
# is mounted at a different path.
# UPLOAD_DIR="/app/storage/uploads"
#
# RUN_MIGRATIONS defaults to "true" — the container entrypoint runs
# `prisma migrate deploy` on start. Set "false" to run migrations as a separate
# release step instead.
# RUN_MIGRATIONS="true"


# ============================================================
# 4) LOCAL DEVELOPMENT ONLY — do NOT set these in Dublyo
#    These configure the local Postgres container in docker-compose.yml.
#    In production you use a managed database via DATABASE_URL instead, so
#    POSTGRES_* are NOT needed on the platform (delete them in Dublyo).
# ============================================================
# POSTGRES_DB=eagles_budget
# POSTGRES_USER=eagles
# POSTGRES_PASSWORD=eagles_secret


# ============================================================
# 5) FUTURE — reserved / not used yet  (do NOT set in Dublyo now)
#    - APP_URL is not referenced anywhere in the app yet.
#    - NVIDIA_* + AI_ANALYSIS_ENABLED are placeholders for a future
#      explanation-only AI layer that will NEVER compute/change numbers.
# ============================================================
# APP_URL="https://your-domain.example"
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=
# NVIDIA_MODEL=
# AI_ANALYSIS_ENABLED=false
