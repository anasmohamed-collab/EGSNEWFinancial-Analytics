# ---------------------------------------------------------------------------
# Eagles Budget CRM - Environment Variables
# Copy this file to `.env` (local) or set these in your platform (production).
# NEVER commit a real `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev matches docker-compose.yml. In PRODUCTION use your managed Postgres
# and require SSL, e.g. append `&sslmode=require`.
DATABASE_URL="postgresql://eagles:eagles_secret@localhost:5432/eagles_budget?schema=public"

# Secret used to sign auth session JWTs. MUST be a long random string (>=32) in prod.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the deployed app (used for links / absolute URLs).
# Local: http://localhost:3000 . Production: your real domain.
APP_URL="http://localhost:3000"

# Directory where original uploaded Excel files are stored.
# PRODUCTION: this MUST point at a PERSISTENT VOLUME mount (see
# DEPLOYMENT_CHECKLIST.md). Without a persistent volume, original uploaded
# files are lost on redeploy (parsed rows still survive in the database).
UPLOAD_DIR="./storage/uploads"

# Seeded default admin credentials (used by prisma/seed.ts).
# Change the password immediately after first login in production.
SEED_ADMIN_EMAIL="admin@eaglesgroup.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Runtime environment. Set to "production" in production (enables secure cookies).
NODE_ENV="development"

# ---------------------------------------------------------------------------
# NVIDIA AI — PLACEHOLDERS ONLY. AI is NOT implemented yet.
# Leave AI_ANALYSIS_ENABLED=false. These are reserved for a future
# explanation-only layer that will NEVER compute or change financial numbers.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
AI_ANALYSIS_ENABLED=false
