# ---------------------------------------------------------------------------
# Eagles Budget CRM - Environment Variables
# Copy this file to `.env` and adjust values for your machine.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Matches the docker-compose.yml service below. Change if you use your own DB.
DATABASE_URL="postgresql://eagles:eagles_secret@localhost:5432/eagles_budget?schema=public"

# Secret used to sign auth session JWTs. MUST be a long random string in prod.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Absolute or relative directory where original uploaded Excel files are stored.
UPLOAD_DIR="./storage/uploads"

# Seeded default admin credentials (used by prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@eaglesgroup.local"
SEED_ADMIN_PASSWORD="Admin@12345"
